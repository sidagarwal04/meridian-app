NEXTAUTH_URL=http://localhost:3456
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional for local development: connect localhost directly to your live Netlify Blobs store.
# (In production on Netlify, Netlify Blobs is configured automatically with zero env vars needed.)
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Optional comma-separated list of admin emails allowed to view /admin private telemetry (defaults to sidaxy@gmail.com)
ADMIN_EMAILS=sidaxy@gmail.com

